# Copy to .env.local for development (and .env on the server). Never commit real values.

# Public origin of the site, used for canonical URLs, sitemap.xml, robots.txt and
# social previews. Must be available at build time. Defaults to http://localhost:3000.
SITE_URL=

# Resend API key (https://resend.com/api-keys). If unset in development, contact
# form submissions are logged to the server console instead of being sent.
RESEND_API_KEY=

# Where contact form messages are delivered.
CONTACT_TO_EMAIL=

# Sender address; must be on a domain verified in Resend, e.g. "Portfolio <contact@example.com>".
CONTACT_FROM_EMAIL=

# --- Deployment (docker-compose.yml) ---

# Cloudflare Tunnel token for the `cloudflared` connector container. Create the tunnel
# in the Zero Trust dashboard (Networks -> Tunnels -> Create a tunnel -> Cloudflared),
# then copy the token from its Docker install command. See DEPLOY.md.
TUNNEL_TOKEN=
